# Muse Console configuration. Use MUSE_CONSOLE_ for new deployments.
# Legacy MUSE2API_ aliases are handled by core; MUSE_CONSOLE_ takes precedence.

# ---- server ----
MUSE_CONSOLE_HOST=127.0.0.1
MUSE_CONSOLE_PORT=18610
MUSE_CONSOLE_LOG_LEVEL=INFO
# External base URL for media links; empty = derive from request
MUSE_CONSOLE_PUBLIC_BASE=

# ---- auth ----
# Empty = auto-generate and store in data/api_key
MUSE_CONSOLE_API_KEY=
# Empty = same as API key
MUSE_CONSOLE_ADMIN_KEY=

# ---- storage ----
MUSE_CONSOLE_DATA_DIR=data
# Days of /v1/* request history kept in data/requests.db (pruned hourly)
MUSE_CONSOLE_REQUEST_LOG_RETENTION_DAYS=14
# Days to keep generated files under data/media (0 = disable automatic cleanup)
MUSE_CONSOLE_MEDIA_RETENTION_DAYS=0
MUSE_CONSOLE_MEDIA_MAX_BYTES=33554432
MUSE_CONSOLE_MEDIA_STORAGE_MAX_BYTES=1073741824
MUSE_CONSOLE_MEDIA_URL_TTL=3600
MUSE_CONSOLE_INPUT_IMAGE_MAX_BYTES=8388608
MUSE_CONSOLE_REQUEST_MAX_BYTES=12582912
MUSE_CONSOLE_REQUEST_MAX_INFLIGHT=16
MUSE_CONSOLE_TASK_MAX_PENDING=32
MUSE_CONSOLE_TASK_MAX_CONCURRENT=4

# ---- driver: mock | browser | http ----
MUSE_CONSOLE_DRIVER=mock
# Upstream site base URL
MUSE_CONSOLE_SITE_URL=https://muse.ai

# browser driver
MUSE_CONSOLE_CHROMIUM_PATH=
# Persistent browser profile dir; empty = data/browser-profile
MUSE_CONSOLE_BROWSER_PROFILE_DIR=
# Browser-only proxy. Leave empty when muse.ai is reachable directly.
MUSE_CONSOLE_BROWSER_PROXY=
# MUSE_CONSOLE_BROWSER_PROXY=socks5://127.0.0.1:10808
MUSE_CONSOLE_CDP_PORT=19210
MUSE_CONSOLE_HEADLESS=true
# Set true only when Chromium cannot use its sandbox (e.g. non-root container
# without user namespaces). Weaker isolation; prefer fixing the sandbox.
MUSE_CONSOLE_CHROMIUM_NO_SANDBOX=false
MUSE_CONSOLE_PAGE_READY_TIMEOUT=45
MUSE_CONSOLE_BROWSER_MAX_TABS=16
MUSE_CONSOLE_BROWSER_IDLE_TTL=900
MUSE_CONSOLE_BROWSER_MEDIA_MAX_BYTES=33554432

# ---- timeouts (seconds) ----
MUSE_CONSOLE_CHAT_TIMEOUT=300
MUSE_CONSOLE_FIRST_TOKEN_TIMEOUT=45
# >0 sends ": keepalive" SSE comments while waiting for the first token (errors then come in-stream).
MUSE_CONSOLE_STREAM_HEARTBEAT_INTERVAL=0
MUSE_CONSOLE_IMAGE_TIMEOUT=240
MUSE_CONSOLE_VIDEO_TIMEOUT=600
MUSE_CONSOLE_VIDEO_DEADLINE_CAP=600
MUSE_CONSOLE_VIDEO_TEXT_ONLY_RETRIES=1

# ---- account pool ----
# lru | round_robin | affinity
# round_robin distributes work fairly; affinity preserves warm conversation pages
MUSE_CONSOLE_POOL_STRATEGY=round_robin
MUSE_CONSOLE_POOL_ACQUIRE_TIMEOUT=60
# Parallel requests per account; start conservatively and tune after live acceptance.
# The browser driver opens one tab per slot; higher limits use more memory.
MUSE_CONSOLE_ACCOUNT_MAX_CONCURRENCY=1
# Seconds an account rests after an upstream error (timeouts excluded).
# Every parallel request on that account waits it out, so keep it short.
MUSE_CONSOLE_ACCOUNT_COOLDOWN=30
MUSE_CONSOLE_MAX_FAILOVER=2

# Isolated manual login sessions, not automatic account/password authentication
MUSE_CONSOLE_LOGIN_SESSION_TTL=600
MUSE_CONSOLE_LOGIN_SESSION_LIMIT=3
MUSE_CONSOLE_LOGIN_AUTO_COMPLETE_ENABLED=false

# Read-only browser extension import; enable only on an explicitly configured origin.
MUSE_CONSOLE_CREDENTIAL_INGESTION_ENABLED=false
MUSE_CONSOLE_CREDENTIAL_SERVER_ORIGIN=
# Development only: permit an exact loopback HTTP origin (never LAN/public HTTP).
MUSE_CONSOLE_CREDENTIAL_ALLOW_LOOPBACK_HTTP=false

# ---- background removal (images with background="transparent") ----
# Needs: pip install -e '.[matting]'. birefnet-general = best, birefnet-general-lite = faster
MUSE_CONSOLE_MATTING_MODEL=birefnet-general

# ---- session keepalive ----
MUSE_CONSOLE_KEEPALIVE_ENABLED=false
MUSE_CONSOLE_KEEPALIVE_INTERVAL=21600
