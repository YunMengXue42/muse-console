{
  "manifest_version": 3,
  "name": "Muse Console",
  "version": "0.1.0",
  "minimum_chrome_version": "132",
  "permissions": ["cookies", "storage", "alarms", "webNavigation"],
  "host_permissions": ["https://muse.ai/*"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": { "service_worker": "worker.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_popup": "popup.html" },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: http://localhost:* http://127.0.0.1:* http://[::1]:*"
  }
}
